# ==============================================================================
# APPS/WEB (NEXT.JS PWA) - ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Copy this file to `apps/web/.env.local` for local development:
#   cp .env.example .env.local
#
# Fallback Mode:
# When these variables are unset or set to placeholder values, the web app
# automatically falls back to an interactive local preview mode with demo data,
# local mock authentication, and curated offline GIFs.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Client Configuration
# ------------------------------------------------------------------------------
# Retrieved from: https://supabase.com/dashboard/project/<PROJECT_ID>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# ------------------------------------------------------------------------------
# 2. LiveKit Cloud (Voice & Video Calls)
# ------------------------------------------------------------------------------
# Retrieved from: https://cloud.livekit.io/projects/<PROJECT_ID>/settings/keys
# Used by LiveKitManager.ts and server-side token generator (/api/livekit-token)
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=API_your_livekit_key_here
LIVEKIT_API_SECRET=your_livekit_secret_here

# ------------------------------------------------------------------------------
# 3. Google OAuth 2.0 (Web Authentication)
# ------------------------------------------------------------------------------
# Retrieved from: https://console.cloud.google.com/apis/credentials
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# ------------------------------------------------------------------------------
# 4. GIF Search Providers (Tenor / Giphy)
# ------------------------------------------------------------------------------
# Free developer keys for GIF picker inside the chat composer.
# If unset, local fallback GIF previews will be displayed automatically.
NEXT_PUBLIC_TENOR_API_KEY=your_tenor_v2_api_key_here
NEXT_PUBLIC_GIPHY_API_KEY=your_giphy_api_key_here
