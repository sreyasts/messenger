# ==============================================================================
# PRIVATE MESSENGER MONOREPO - ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# This file defines all environment variables required for the $0 Free-Tier
# Private Messenger stack across Web (PWA), Android Native, and Supabase Backend.
#
# FALLBACK BEHAVIOR:
# Both the Web PWA (apps/web) and Android client (apps/android) are designed with
# built-in mock and fallback engines. If any or all of these keys are omitted or
# unset, the applications will gracefully run in offline/mock preview mode with
# zero crashes.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE BACKEND (Database, Auth, Realtime & Object Storage)
# ------------------------------------------------------------------------------
# Free Tier Limits:
# - PostgreSQL Database: 500 MB storage, 2 active projects
# - Monthly Active Users (MAU): 50,000 free authenticated users
# - Supabase Storage: 1 GB total object storage, 50 MB max file size per object
# - Supabase Realtime: 200 concurrent WebSocket connections, 2M messages/month
#
# Where to find these in Supabase Dashboard:
# 1. Sign in to https://supabase.com/dashboard
# 2. Select your project -> Project Settings -> API
# 3. Copy "Project URL" -> NEXT_PUBLIC_SUPABASE_URL
# 4. Copy "anon public" API Key -> NEXT_PUBLIC_SUPABASE_ANON_KEY
# 5. Copy "service_role secret" API Key -> SUPABASE_SERVICE_ROLE_KEY
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# ------------------------------------------------------------------------------
# 2. LIVEKIT CLOUD (Voice & Video Calls via WebRTC SFU)
# ------------------------------------------------------------------------------
# Free Tier Limits:
# - Cloud Free "Build" Plan: 5,000 participant minutes/month, 50 GB monthly bandwidth
# - Codecs: Opus HD audio (echo cancellation, noise suppression, AGC) + VP8/H.264 video
# - STUN Fallback: stun.l.google.com:19302 (Public Google STUN, $0 cost)
#
# Where to find these in LiveKit Cloud Console:
# 1. Sign in to https://cloud.livekit.io
# 2. Project Settings -> Keys -> Generate Key
# 3. Copy WebSocket Server URL (wss://...) -> NEXT_PUBLIC_LIVEKIT_URL & LIVEKIT_URL
# 4. Copy API Key -> LIVEKIT_API_KEY
# 5. Copy API Secret -> LIVEKIT_API_SECRET
#
# Note: In Supabase Edge Functions, set these secrets via Supabase CLI:
#   supabase secrets set LIVEKIT_URL=wss://... LIVEKIT_API_KEY=... LIVEKIT_API_SECRET=...
# ------------------------------------------------------------------------------
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=API_your_livekit_key_here
LIVEKIT_API_SECRET=your_livekit_secret_here

# ------------------------------------------------------------------------------
# 3. GOOGLE OAUTH 2.0 (Open-Access User Onboarding)
# ------------------------------------------------------------------------------
# Where to find these in Google Cloud Console:
# 1. Open https://console.cloud.google.com -> APIs & Services -> Credentials
# 2. Create an OAuth 2.0 Client ID for "Web application":
#    - Authorized JavaScript origins: https://your-project-id.supabase.co, http://localhost:3000
#    - Authorized redirect URIs: https://your-project-id.supabase.co/auth/v1/callback
# 3. In Supabase Dashboard -> Authentication -> Providers -> Google:
#    - Enable Google provider, enter Client ID and Client Secret.
# 4. For Android:
#    - Use the Web Client ID as GOOGLE_SERVER_CLIENT_ID for Google Credential Manager token exchange.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
GOOGLE_SERVER_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# 4. GIF SEARCH INTEGRATION (Tenor v2 / Giphy)
# ------------------------------------------------------------------------------
# Free Tier Limits:
# - Tenor API: Free tier on Google Cloud Console (up to 1 request/second standard)
# - Giphy API: Free Developer Sandbox tier (42 search requests/hour, 1,000/day)
#
# How to obtain keys:
# - Tenor: Google Cloud Console -> Enable "Tenor API" -> Create API Key
#   https://developers.google.com/tenor/guides/quickstart
# - Giphy: Giphy Developer Portal -> Create App -> API Key
#   https://developers.giphy.com/dashboard/
#
# Note: If neither key is provided, the messenger falls back to offline curated GIFs.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_TENOR_API_KEY=your_tenor_v2_api_key_here
NEXT_PUBLIC_GIPHY_API_KEY=your_giphy_api_key_here
